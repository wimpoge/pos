# Local development defaults to SQLite (./pos.db).
# POS_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
# POS_SERVERLESS=true      # on Vercel: no connection pool per function instance
# POS_COOKIE_SECURE=true   # session cookie only over HTTPS

# The ERP and the API client made for this POS in the ERP (Settings > API clients).
POS_ERP_URL=http://localhost:8000
POS_ERP_CLIENT_ID=cli_xxxxxxxxxxxxxxxx
POS_ERP_CLIENT_SECRET=

POS_TIMEZONE=Asia/Jakarta
# Vercel Cron calls /api/cron/sync with "Authorization: Bearer <POS_CRON_SECRET>". Set it in Vercel as CRON_SECRET too.
POS_CRON_SECRET=

# Till rules: the highest line discount a cashier may type, and the receipt footer.
# POS_MAX_DISCOUNT_PCT=10
# POS_RECEIPT_FOOTER=Thank you for shopping with us!

# Shop time when open shifts end by themselves (none opens again until the next day). Empty: never.
# POS_SHIFT_END_TIME=17:00
